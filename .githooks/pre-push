#!/bin/sh
# Pre-push gate: nothing reaches the remote unless `task check` or
# `task check:fast` passed for exactly the code being pushed.
#
# `task check` (the full gate, Taskfile.lore.yml) ends by writing the tree id
# of the tracked files it tested to .git/lore-check-passed; `task check:fast`
# (the fast tier for small fixes) writes .git/lore-check-fast-passed. A push
# whose commits all have a stamped tree goes through at once; anything else
# runs the full gate first, and a push of code the gate did not see
# (uncommitted changes while checking) is refused. The landing rule
# (docs/DEVELOPMENT.md "Landing"): a small fix lands after check:fast, and the
# full gate then runs on the landed main (task check:after-land). Install with
# `task hooks:install`. Emergency bypass, which skips every check:
# git push --no-verify

stamp_file=$(git rev-parse --git-path lore-check-passed)
fast_stamp_file=$(git rev-parse --git-path lore-check-fast-passed)
zero=0000000000000000000000000000000000000000

# stamped TREE: TREE passed the full gate or the fast tier.
stamped() {
	[ -f "$stamp_file" ] && [ "$1" = "$(cat "$stamp_file")" ] && return 0
	[ -f "$fast_stamp_file" ] && [ "$1" = "$(cat "$fast_stamp_file")" ] && return 0
	return 1
}

# git passes "<local ref> <local sha> <remote ref> <remote sha>" per ref.
trees=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # deleting a remote ref: nothing to test
	tree=$(git rev-parse "$local_sha^{tree}" 2>/dev/null) || continue
	trees="$trees $tree"
done
[ -z "$trees" ] && exit 0

all_stamped() {
	for t in $trees; do
		stamped "$t" || return 1
	done
	return 0
}

if all_stamped; then
	echo "pre-push: task check (or check:fast) already passed for this code"
	exit 0
fi

if ! command -v task >/dev/null 2>&1; then
	echo "pre-push: \`task\` (taskfile.dev) is not installed, so the gate cannot run — push blocked" >&2
	exit 1
fi

# git exports GIT_DIR (and, in some setups, GIT_WORK_TREE, GIT_INDEX_FILE,
# ...) to every hook. Left set, every `git -C <tempdir> ...` a test runs
# acts on THIS repository instead: issue #6 saw .git/config turned bare,
# origin pointed at a temp folder, junk remotes, a shallow file and a
# broken worktree link. lore strips these itself (logic/gitenv), but tests
# start git directly too, so the gate runs without them. The list matches
# gitenv.RepoLocating; the stamp lookups above ran before this on purpose.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_NAMESPACE GIT_PREFIX \
	GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
	GIT_QUARANTINE_PATH GIT_SHALLOW_FILE GIT_GRAFT_FILE GIT_CONFIG

echo "pre-push: running task check (the full gate) before pushing…"
if ! task check </dev/null; then
	echo "pre-push: task check failed — push blocked" >&2
	exit 1
fi

if ! all_stamped; then
	echo "pre-push: the gate tested your working tree, which differs from the commits being pushed (uncommitted changes). Commit or stash them and push again — push blocked" >&2
	exit 1
fi
